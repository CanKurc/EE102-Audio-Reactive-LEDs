# ============================================================
#  .gitattributes — language detection overrides
# ============================================================
#  GitHub's Linguist counts every file in the repo when computing
#  the language breakdown. Vivado auto-generates large amounts of
#  Verilog, SystemVerilog, and C++ inside the IP folders (XADC
#  wizard, etc.) which then dominates the language pie chart and
#  hides the fact that this is a VHDL project.
#
#  These rules mark the generated content so GitHub displays the
#  hand-written VHDL as the dominant language, where it belongs.
# ============================================================

# ---- Vivado-generated IP (Verilog, SystemVerilog, headers) ----
vivado_project/**/*.v            linguist-generated=true
vivado_project/**/*.sv           linguist-generated=true
vivado_project/**/*.vh           linguist-generated=true
vivado_project/**/*.svh          linguist-generated=true

# ---- C / C++ stubs inside generated IP ----
vivado_project/**/*.c            linguist-generated=true
vivado_project/**/*.cpp          linguist-generated=true
vivado_project/**/*.h            linguist-generated=true
vivado_project/**/*.hpp          linguist-generated=true

# ---- Tcl scripts generated by Vivado ----
vivado_project/**/*.tcl          linguist-generated=true

# ---- Auto-generated block design wrappers ----
vivado_project/**/bd/**          linguist-generated=true
vivado_project/**/ip/**          linguist-generated=true
vivado_project/**/sim_*/**       linguist-generated=true

# ---- Mark XDC as vendored so it doesn't show as Tcl ----
*.xdc                            linguist-language=Tcl
*.xdc                            linguist-vendored=true

# ---- Explicit: VHDL is the real source ----
*.vhd                            linguist-language=VHDL
*.vhdl                           linguist-language=VHDL